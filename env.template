# Personal Knowledge Agent — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored.
# SECURITY: API keys are never stored inside the knowledge database (spec §27).
# They live only in this environment file / process environment.

# Runtime
APP_ENV=development

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Vector store
QDRANT_URL=http://localhost:6333

# Default LLM (swappable via LLM_PROVIDER without touching domain code)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:26b

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# PayPerQ (OpenAI-compatible)
PAYPERQ_BASE_URL=https://api.ppq.ai/v1
PAYPERQ_API_KEY=

# OpenCode Go (OpenAI-compatible endpoint; flat $10/mo subscription)
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=glm-5.3

# Cost rates in USD per 1k tokens (input/output); used for token accounting.
# Zero/empty = free (local Ollama) or flat-rate (OpenCode Go $10/mo).
# Set PAYPERQ_USD_PER_1K_* to your real PayPerQ billing rates.
OLLAMA_USD_PER_1K_IN=0.0
OLLAMA_USD_PER_1K_OUT=0.0
PAYPERQ_USD_PER_1K_IN=0.0
PAYPERQ_USD_PER_1K_OUT=0.0
OPENCODE_GO_USD_PER_1K_IN=0.0
OPENCODE_GO_USD_PER_1K_OUT=0.0

# Embeddings (interchangeable provider)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Qdrant collection dimensionality; must match the embedding model's output
EMBEDDING_DIMENSIONS=768

# LLM HTTP timeout in seconds (local models need generous timeouts)
LLM_TIMEOUT_SECONDS=300

# Document chunking defaults for ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=120