# Copiá a deploy/nas/.env y completá los valores:  cp env.template .env
# PKA lee estas variables vía env_file; las API keys jamás van a la base de
# conocimiento (spec §27).

# --- Proveedor de chat (nube, decisión de producto) ---
LLM_PROVIDER=opencode_go
OPENCODE_GO_API_KEY=sk-...
OPENCODE_GO_MODEL=glm-5.3

# --- PayPerQ (opcional; cambiá LLM_PROVIDER=payperq y LLM_MODEL) ---
# PAYPERQ_API_KEY=
# PAYPERQ_BASE_URL=https://api.ppq.ai/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# PAYPERQ_USD_PER_1K_IN=0.0
# PAYPERQ_USD_PER_1K_OUT=0.0

# --- Fallback local (opcional; Ollama en el stack es para embeddings) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b